<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Balance d'ouverture : une par société, brouillon puis validée en une seule écriture (journal des à-nouveaux). -->
    <record id="view_microfinance_opening_balance_tree" model="ir.ui.view">
        <field name="name">microfinance.opening.balance.tree</field>
        <field name="model">microfinance.opening.balance</field>
        <field name="arch" type="xml">
            <tree string="Balances d'ouverture" decoration-muted="state == 'draft'" decoration-danger="difference != 0">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="difference" string="Écart"/>
                <field name="state" widget="badge" decoration-success="state == 'validated'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_microfinance_opening_balance_form" model="ir.ui.view">
        <field name="name">microfinance.opening.balance.form</field>
        <field name="model">microfinance.opening.balance</field>
        <field name="arch" type="xml">
            <form string="Balance d'ouverture" duplicate="false">
                <header>
                    <button name="action_validate" type="object" string="Valider la balance" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="microfinance_loan_management.group_microfinance_finance,microfinance_loan_management.group_microfinance_comptable,account.group_account_manager"/>
                    <button name="action_load_template" type="object" string="Charger le modèle" invisible="state != 'draft'"
                            groups="microfinance_loan_management.group_microfinance_finance,microfinance_loan_management.group_microfinance_comptable,account.group_account_manager"/>
                    <button name="action_download_template" type="object" string="Télécharger le modèle Excel"
                            invisible="not id"/>
                    <button name="action_open_import_wizard" type="object" string="Importer le fichier Excel"
                            invisible="state != 'draft' or not id"
                            groups="microfinance_loan_management.group_microfinance_finance,microfinance_loan_management.group_microfinance_comptable,account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_account_moves_all_a)d" type="action" class="oe_stat_button" icon="fa-book"
                                invisible="not move_id" context="{'search_default_move_id': move_id}">
                            <div class="o_stat_info"><span class="o_stat_text">Écriture d'ouverture</span></div>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="difference == 0 or state == 'validated'">
                        La balance n'est pas équilibrée : elle ne pourra pas être validée tant que le total des débits
                        diffère du total des crédits.
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state == 'validated' or line_count"/>
                            <field name="date" readonly="state == 'validated'"/>
                            <field name="move_id" readonly="1" invisible="not move_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="line_count" invisible="1"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="difference" decoration-danger="difference != 0" decoration-success="difference == 0"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'validated'">
                        <tree editable="bottom" string="Lignes de la balance">
                            <field name="company_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="partner_id" optional="show"/>
                            <field name="name" optional="show"/>
                            <field name="debit" sum="Total débit"/>
                            <field name="credit" sum="Total crédit"/>
                        </tree>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_microfinance_opening_balance_search" model="ir.ui.view">
        <field name="name">microfinance.opening.balance.search</field>
        <field name="model">microfinance.opening.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter name="draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="validated" string="Validées" domain="[('state', '=', 'validated')]"/>
            </search>
        </field>
    </record>

    <record id="action_microfinance_opening_balance" model="ir.actions.act_window">
        <field name="name">Balance d'ouverture</field>
        <field name="res_model">microfinance.opening.balance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_microfinance_opening_balance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez la balance d'ouverture de la société</p>
            <p>Saisissez les soldes de départ (ou importez le fichier Excel), puis validez : une seule écriture est créée.</p>
        </field>
    </record>

    <!-- Comptes du modèle (liste configurable) -->
    <record id="view_microfinance_opening_template_tree" model="ir.ui.view">
        <field name="name">microfinance.opening.template.tree</field>
        <field name="model">microfinance.opening.template</field>
        <field name="arch" type="xml">
            <tree string="Comptes du modèle" editable="bottom" default_order="sequence, code">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="block"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_microfinance_opening_template" model="ir.actions.act_window">
        <field name="name">Comptes du modèle d'ouverture</field>
        <field name="res_model">microfinance.opening.template</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Assistant d'import Excel -->
    <record id="view_microfinance_opening_import_form" model="ir.ui.view">
        <field name="name">microfinance.opening.balance.import.form</field>
        <field name="model">microfinance.opening.balance.import</field>
        <field name="arch" type="xml">
            <form string="Importer le fichier Excel">
                <group>
                    <field name="balance_id" invisible="1"/>
                    <field name="has_errors" invisible="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="report" invisible="not report"/>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button name="action_close" type="object" string="Fermer" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu Comptabilité : Finance, Comptable, Auditeur (lecture) et gestionnaire comptable ; pas de Configuration ni de Caisse -->
    <menuitem id="menu_microfinance_opening_balance" name="Balance d'ouverture" parent="account.menu_finance_entries"
              action="action_microfinance_opening_balance" sequence="6"
              groups="microfinance_loan_management.group_microfinance_finance,microfinance_loan_management.group_microfinance_comptable,microfinance_loan_management.group_microfinance_auditor,account.group_account_manager"/>
    <menuitem id="menu_microfinance_opening_template" name="Comptes du modèle d'ouverture" parent="account.menu_finance_entries"
              action="action_microfinance_opening_template" sequence="7"
              groups="microfinance_loan_management.group_microfinance_comptable,account.group_account_manager"/>
</odoo>
