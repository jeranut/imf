<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_caisse_session_tree" model="ir.ui.view">
        <field name="name">microfinance.caisse.session.tree</field>
        <field name="model">microfinance.caisse.session</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'closed'" decoration-info="state == 'open'" decoration-muted="state == 'draft'">
                <field name="date"/>
                <field name="journal_id"/>
                <field name="cashier_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="opening_balance"/>
                <field name="closing_balance"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_microfinance_caisse_session_form" model="ir.ui.view">
        <field name="name">microfinance.caisse.session.form</field>
        <field name="model">microfinance.caisse.session</field>
        <field name="arch" type="xml">
            <form string="Session de caisse">
                <header>
                    <button name="action_open_session" string="Ouvrir la session" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close_session" string="Clôturer la session" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="company_id" invisible="1"/>
                            <field name="journal_id" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="cashier_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="fiche_journee_id" readonly="1"/>
                            <field name="opening_balance"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="closing_balance"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_microfinance_caisse_session_search" model="ir.ui.view">
        <field name="name">microfinance.caisse.session.search</field>
        <field name="model">microfinance.caisse.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="journal_id"/>
                <field name="cashier_id"/>
                <field name="company_id"/>
                <field name="date"/>
                <filter name="today" string="Aujourd'hui" domain="[('date', '=', context_today())]"/>
                <filter name="open" string="Ouvertes" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Clôturées" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_cashier" string="Caissier" context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_company" string="Agence" context="{'group_by': 'company_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_microfinance_caisse_session" model="ir.actions.act_window">
        <field name="name">Sessions de caisse</field>
        <field name="res_model">microfinance.caisse.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
