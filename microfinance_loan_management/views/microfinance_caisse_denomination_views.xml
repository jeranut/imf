<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_caisse_denomination_tree" model="ir.ui.view">
        <field name="name">microfinance.caisse.denomination.tree</field>
        <field name="model">microfinance.caisse.denomination</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="value"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_microfinance_caisse_denomination_search" model="ir.ui.view">
        <field name="name">microfinance.caisse.denomination.search</field>
        <field name="model">microfinance.caisse.denomination</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="value"/>
                <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_microfinance_caisse_denomination" model="ir.actions.act_window">
        <field name="name">Coupures de caisse</field>
        <field name="res_model">microfinance.caisse.denomination</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Définissez les valeurs de billets et pièces</p>
            <p>Ces coupures sont proposées au caissier lors du comptage de billetage à la clôture de session.</p>
        </field>
    </record>
</odoo>
