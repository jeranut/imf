<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_visit_tree" model="ir.ui.view"><field name="name">microfinance.collection.visit.tree</field><field name="model">microfinance.collection.visit</field><field name="arch" type="xml"><tree><field name="loan_id"/><field name="partner_id"/><field name="agent_id"/><field name="visit_date"/><field name="next_visit_date"/><field name="status" widget="badge"/><field name="promise_to_pay_date"/><field name="promised_amount"/></tree></field></record>
    <record id="view_microfinance_visit_form" model="ir.ui.view"><field name="name">microfinance.collection.visit.form</field><field name="model">microfinance.collection.visit</field><field name="arch" type="xml"><form><sheet><group><group><field name="loan_id"/><field name="partner_id" context="{'microfinance_context': True}"/><field name="agent_id"/><field name="status"/></group><group><field name="visit_date"/><field name="next_visit_date"/><field name="promise_to_pay_date"/><field name="promised_amount"/></group></group><group><field name="remarks"/></group></sheet><chatter/></form></field></record>
    <!-- Vue dédiée, sans création ni duplication : formulaire ouvert par l'onglet "Mes visites"
         du tableau de bord (Mon portefeuille, openPortfolioTabRow) - cf.
         docs_dev/dashboard_creation_bloquee/. Jamais utilisée par le menu "Visites de
         recouvrement" (action_microfinance_visit), qui garde sa vue générique (création
         inchangée). -->
    <record id="view_microfinance_visit_form_dashboard" model="ir.ui.view"><field name="name">microfinance.collection.visit.form.dashboard.readonly.create</field><field name="model">microfinance.collection.visit</field><field name="inherit_id" ref="view_microfinance_visit_form"/><field name="mode">primary</field><field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="create">0</attribute><attribute name="duplicate">0</attribute></xpath></field></record>
    <record id="view_microfinance_visit_calendar" model="ir.ui.view"><field name="name">microfinance.collection.visit.calendar</field><field name="model">microfinance.collection.visit</field><field name="arch" type="xml"><calendar date_start="visit_date" date_stop="next_visit_date" color="agent_id"><field name="loan_id"/><field name="partner_id"/><field name="status"/></calendar></field></record>
    <record id="action_microfinance_visit" model="ir.actions.act_window"><field name="name">Visites de recouvrement</field><field name="res_model">microfinance.collection.visit</field><field name="view_mode">tree,form,calendar</field></record>
</odoo>
