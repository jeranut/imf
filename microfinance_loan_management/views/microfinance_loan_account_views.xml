<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_account_tree" model="ir.ui.view">
        <field name="name">microfinance.loan.account.tree</field>
        <field name="model">microfinance.loan.account</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="loan_count"/>
            </tree>
        </field>
    </record>

    <record id="view_microfinance_loan_account_form" model="ir.ui.view">
        <field name="name">microfinance.loan.account.form</field>
        <field name="model">microfinance.loan.account</field>
        <field name="arch" type="xml">
            <form string="Compte crédit" create="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page string="Crédits">
                            <field name="loan_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="loan_amount"/>
                                    <field name="application_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_microfinance_loan_account" model="ir.actions.act_window">
        <field name="name">Compte crédit</field>
        <field name="res_model">microfinance.loan.account</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
