<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_tree" model="ir.ui.view">
        <field name="name">microfinance.loan.tree</field>
        <field name="model">microfinance.loan</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'defaulted'" decoration-muted="state == 'written_off'" decoration-success="state == 'closed'" decoration-warning="overdue_amount &gt; 0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="loan_amount"/>
                <field name="balance_total"/>
                <field name="overdue_amount"/>
                <field name="internal_score" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_microfinance_loan_kanban" model="ir.ui.view">
        <field name="name">microfinance.loan.kanban</field>
        <field name="model">microfinance.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/><field name="partner_id"/><field name="loan_amount"/><field name="balance_total"/><field name="internal_score"/><field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div>Montant : <field name="loan_amount"/></div>
                            <div>Solde : <field name="balance_total"/></div>
                            <div>Score : <field name="internal_score"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_microfinance_loan_search" model="ir.ui.view">
        <field name="name">microfinance.loan.search</field>
        <field name="model">microfinance.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="active" string="Actifs" domain="[('state','=','active')]"/>
                <filter name="overdue" string="Avec impayés" domain="[('overdue_amount','&gt;',0)]"/>
                <filter name="defaulted" string="En défaut" domain="[('state','=','defaulted')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État" context="{'group_by':'state'}"/>
                    <filter name="group_product" string="Produit" context="{'group_by':'product_id'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by':'officer_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_microfinance_loan_form" model="ir.ui.view">
        <field name="name">microfinance.loan.form</field>
        <field name="model">microfinance.loan</field>
        <field name="arch" type="xml">
            <form string="Crédit" js_class="microfinance_loan_form" class="o_microfinance_loan_form">
                <header>
                    <!-- Barre d'état sur sa propre ligne, au-dessus des boutons (rendu en
                         segments accolés via static/src/scss/microfinance_loan_form.scss).
                         clickable laissé au défaut Odoo (= cliquable pour un manager). -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,enquete,avis_ca,avis_cdag,approved,active,closed,defaulted,written_off"/>
                    <button name="action_start_enquete" string="Démarrer l'enquête" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ca_review" string="Avis CA" type="object" groups="microfinance_loan_management.group_microfinance_credit_committee" invisible="state != 'enquete'"/>
                    <button name="action_cdag_review" string="Avis CDAG" type="object" groups="microfinance_loan_management.group_microfinance_credit_committee" invisible="state != 'avis_ca'"/>
                    <button name="action_approve" string="Approuver" type="object" groups="microfinance_loan_management.group_microfinance_manager" invisible="state != 'avis_cdag'"/>
                    <button name="action_send_fee_to_cashier" string="Envoyer les frais en caisse" type="object" groups="microfinance_loan_management.group_microfinance_finance" invisible="state != 'approved' or fee_paid or fee_amount_due &lt;= 0 or fee_sent_to_cashier or not fee_charged_before_disbursement"/>
                    <!-- Découplage activation / décaissement (docs_dev/guichet_caisse/
                         AUDIT_decaissement.md) : ce bouton ne fait plus que passer le crédit à
                         'active' (contrôles conservés) ; le décaissement effectif (écriture de
                         sortie de caisse) a lieu au Guichet Caisse. -->
                    <button name="action_activate" string="Activer" type="object" class="btn-primary" groups="microfinance_loan_management.group_microfinance_finance" invisible="state != 'approved'"/>
                    <button name="action_open_payment_wizard" string="Enregistrer remboursement" type="object" class="btn-primary" invisible="state not in ('active','defaulted')"/>
                    <button name="action_reschedule" string="Rééchelonner" type="object" groups="microfinance_loan_management.group_microfinance_manager" invisible="state != 'active'"/>
                    <button name="action_mark_default" string="Marquer en défaut" type="object" invisible="state != 'active'"/>
                    <button name="action_close" string="Clôturer" type="object" invisible="state not in ('active','defaulted')"/>
                    <button name="action_write_off" string="Radier" type="object" groups="microfinance_loan_management.group_microfinance_manager,microfinance_loan_management.group_microfinance_finance" invisible="state not in ('active','defaulted')"/>
                    <!-- Les 3 boutons d'impression du header ("Imprimer le reçu",
                         "Imprimer le calendrier", "Imprimer le carnet" - ce dernier ajouté
                         dans un lot précédent, poste le PDF dans le chatter au lieu d'un
                         report_action direct) sont regroupés dans un seul menu déroulant
                         "Imprimer" pour ne pas continuer à empiler des boutons au même
                         niveau visuel que les boutons de statut. Le bouton toggle porte
                         data-bs-toggle (Bootstrap 5, pas data-toggle) : le sélecteur Odoo
                         "button:not([data-bs-toggle])" (view_compiler.js) l'exclut donc
                         explicitement de la compilation en ViewButton - rendu comme un
                         <button> HTML natif ordinaire, pas une action serveur. Les 3
                         <button> internes, eux, restent des ViewButton normaux (repérés à
                         n'importe quelle profondeur dans l'arch, comme dans button_box) et
                         conservent name/type/invisible identiques à l'ancien bouton
                         correspondant - même comportement, juste regroupé visuellement. -->
                    <div class="btn-group" role="group">
                        <button name="print_menu_toggle" type="button" class="btn btn-cefor-print dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fa fa-print"/> Imprimer
                        </button>
                        <div class="dropdown-menu" role="menu">
                            <button name="%(action_report_microfinance_loan_disbursement_receipt)d" type="action"
                                    class="dropdown-item" string="Imprimer le reçu"
                                    invisible="state in ('draft','enquete','avis_ca','avis_cdag','approved','cancelled')"/>
                            <button name="action_print_repayment_schedule" type="object"
                                    class="dropdown-item" string="Imprimer le calendrier"
                                    invisible="installment_count == 0"/>
                            <button name="action_print_carnet_remboursement" type="object"
                                    class="dropdown-item" string="Imprimer le carnet"/>
                        </div>
                    </div>
                    <!-- Contrat de crédit : visible uniquement à l'état "Approuvé", pour
                         Agent crédit / Manager / Gestionnaire (group_microfinance_user est le
                         socle impliqué par manager et gestionnaire). Appelle une méthode
                         (type="object") qui poste le PDF dans le chatter — pas de
                         téléchargement, pas d'action de rapport directe. Même classe verte
                         btn-cefor-print + icône que "Imprimer le calendrier". -->
                    <button name="action_print_contrat_to_chatter" type="object" class="btn-cefor-print" groups="microfinance_loan_management.group_microfinance_user" invisible="state != 'approved'">
                        <i class="fa fa-print"/> Imprimer le contrat
                    </button>
                    <!-- Dépôt du contrat signé : ouvre microfinance.loan.contract.signature.wizard
                         (docs_dev/date_signature_contrat/) plutôt qu'un upload direct - le
                         fichier ET sa date de signature sont saisis ensemble puis verrouillés
                         définitivement dès confirmation (_check_contract_signature_locked()),
                         quel que soit l'état du dossier ensuite. Remplace l'ancien widget
                         signed_contract_upload (habillage visuel du binary standard, devenu
                         inutile - retiré avec ce lot). Invisible dès que
                         contract_signature_date est renseigné : plus aucun moyen de rouvrir ce
                         wizard une fois le contrat confirmé (le widget natif du panneau SUIVI
                         passe lui aussi en readonly permanent, cf. groupe "Suivi" plus bas). -->
                    <button name="action_open_contract_signature_wizard" type="object" class="btn-cefor-print"
                            invisible="state not in ('approved', 'active', 'closed', 'defaulted', 'written_off') or contract_signature_date">
                        <i class="fa fa-upload"/> Téléverser le contrat signé
                    </button>
                    <!-- Génération manuelle de l'échéancier : remède au trou laissé par le
                         retrait du bouton historique (docs_dev/retrait_bouton_generer_echeancier/,
                         docs_dev/bouton_generation_echeancier/) - un dossier créé puis approuvé
                         sans ré-écriture d'un champ source (_SCHEDULE_TRIGGER_FIELDS) ni flux
                         avis ni décaissement n'a jamais d'échéancier persisté (cas IS/003362).
                         Toujours visible tant que le crédit est modifiable et que le calcul est
                         possible (montant + nb échéances + périodicité) : permet aussi un
                         recalcul forcé sur un échéancier existant (décision Micka). Le garde-fou
                         loan_amount/term est doublé côté serveur dans
                         action_generate_schedule_button(). -->
                    <button name="action_generate_schedule_button" type="object"
                            groups="microfinance_loan_management.group_microfinance_user"
                            invisible="state not in ('draft','enquete','avis_ca','avis_cdag','approved') or not loan_amount or not term or not repayment_frequency_id">
                        <i class="fa fa-calendar-plus-o"/> Générer l'échéancier
                    </button>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installments" type="object" class="oe_stat_button" icon="fa-calendar"><field name="installment_count" widget="statinfo" string="Échéances"/></button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money"><field name="payment_count" widget="statinfo" string="Paiements"/></button>
                        <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-map-marker"><field name="visit_count" widget="statinfo" string="Visites"/></button>
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book"><field name="move_count" widget="statinfo" string="Écritures"/></button>
                        <button name="action_view_applications" type="object" class="oe_stat_button" icon="fa-search" invisible="state == 'draft'">
                            <field name="application_count" widget="statinfo" string="Enquête"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <!-- Crédit activé mais pas encore décaissé en caisse (découplage
                             activation / décaissement) : indicateur discret, pas un champ badge
                             dédié. Se lève dès que disbursement_date est posé. -->
                        <span class="text-warning" invisible="state != 'active' or disbursement_date">
                            <i class="fa fa-clock-o"/> En attente de décaissement en caisse
                        </span>
                    </div>
                    <group>
                        <group string="Dossier">
                            <field name="partner_id"/>
                            <!-- readonly dès avis_ca/avis_cdag (et tous les états suivants) sur
                                 product_id/loan_amount/term/installment_amount : verrouillage
                                 des champs "Calcul crédit" après avis rendu (Lot 1, docs_dev/
                                 verrouillage_calcul_credit/) - filet côté vue, doublé du filet
                                 serveur _check_locked_dossier_fields() dans microfinance_loan.py
                                 (write()), seul rempart réel puisqu'un readonly de vue seul est
                                 contournable (API, import). Liste d'états reprise à l'identique
                                 de _LOCKED_DOSSIER_STATES - la faire évoluer aux deux endroits
                                 en même temps si jamais modifiée. -->
                            <field name="product_id" readonly="state in ('avis_ca','avis_cdag','approved','active','closed','defaulted','written_off')"/>
                            <!-- Pas de groups="base.group_multi_company" : le domaine de
                                 fond_credit_id ci-dessous référence company_id, qui doit donc
                                 rester présent dans la vue quel que soit le groupe (même
                                 exception que sur microfinance_loan_product_views.xml). -->
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="loan_amount" readonly="state in ('avis_ca','avis_cdag','approved','active','closed','defaulted','written_off')"/>
                            <field name="term" readonly="state in ('avis_ca','avis_cdag','approved','active','closed','defaulted','written_off')"/>
                            <field name="installment_amount" readonly="state in ('avis_ca','avis_cdag','approved','active','closed','defaulted','written_off')"/>
                            <field name="repayment_frequency_mode" invisible="1"/>
                            <field name="allowed_repayment_frequency_ids" invisible="1"/>
                            <field name="repayment_frequency_id" readonly="repayment_frequency_mode == 'fixed'"/>
                            <field name="has_active_fond" invisible="1"/>
                            <field name="fond_credit_id" required="has_active_fond" readonly="disbursement_date != False"/>
                            <field name="co_borrower_id"/>
                        </group>
                        <group string="Suivi">
                            <field name="application_date"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="activation_date" readonly="1" invisible="not activation_date"/>
                            <field name="disbursement_date" readonly="1"/>
                            <field name="contract_signature_date" readonly="1"/>
                            <field name="officer_id"/>
                            <field name="manager_id"/>
                            <field name="finance_user_id"/>
                            <field name="collection_agent_id"/>
                            <field name="reschedule_count"/>
                            <!-- Contrat signé : consultation/téléchargement uniquement depuis ce
                                 panneau (docs_dev/date_signature_contrat/) - le dépôt se fait
                                 exclusivement via le bouton header "Téléverser le contrat signé"
                                 (microfinance.loan.contract.signature.wizard), qui écrit ce champ
                                 ET contract_signature_date ensemble puis les verrouille tous les
                                 deux définitivement (_check_contract_signature_locked()).
                                 readonly="1" inconditionnel : plus aucune interaction d'upload
                                 direct depuis cet emplacement, que le contrat soit déjà signé ou
                                 non (avant signature, seul le bouton header permet l'upload). -->
                            <field name="signed_contract_filename" invisible="1"/>
                            <field name="signed_contract" widget="binary" filename="signed_contract_filename" readonly="1" invisible="state not in ('approved', 'active', 'closed', 'defaulted', 'written_off')"/>
                        </group>
                    </group>
                    <!-- 2 colonnes par thème (même pattern que le <group> Dossier/Suivi
                         ci-dessus) : name="resume_financier_wrapper" sert d'ancrage stable
                         pour les xpaths d'autres modules (microfinance_savings_management,
                         microfinance_scoring_views.xml) - ne pas le renommer sans répercuter
                         le changement dans ces deux fichiers (docs_dev/
                         resume_financier_colonnes/). -->
                    <group name="resume_financier_wrapper">
                        <group string="Résumé financier — Crédit">
                            <field name="principal_total" readonly="1"/>
                            <field name="interest_total" readonly="1"/>
                            <field name="penalty_total" readonly="1"/>
                            <field name="paid_total" readonly="1"/>
                            <field name="balance_total" readonly="1"/>
                            <field name="overdue_amount" readonly="1"/>
                            <field name="overdue_installment_count" readonly="1"/>
                            <!-- Score + bouton "Recalculer le score" sur la même ligne.
                                 Le couple <label> + <div class="o_row"> forme une paire
                                 label/valeur normale de la grille du <group> : un <button> nu
                                 enfant direct ne consommerait qu'une demi-paire et décalerait
                                 tout l'alignement en dessous. name/type du bouton inchangés. -->
                            <label for="internal_score" string="Score"/>
                            <div class="o_row">
                                <field name="internal_score" widget="progressbar" readonly="1" nolabel="1"/>
                                <button name="action_recompute_risk" string="Recalculer le score" type="object" class="btn-secondary btn-sm" icon="fa-refresh"/>
                            </div>
                            <field name="provision_amount" readonly="1"/>
                            <field name="provision_posted_amount" readonly="1"/>
                            <field name="fee_amount_due" readonly="1"/>
                            <!-- Badge état frais (vert payé / rouge non payé), style calqué sur le
                                 badge risk_level du scoring. fee_paid reste dans la vue (invisible)
                                 car le bouton "Envoyer les frais en caisse" l'utilise dans son
                                 modifier invisible=. -->
                            <field name="fee_payment_state" widget="badge" readonly="1"
                                   decoration-success="fee_payment_state == 'paid'"
                                   decoration-danger="fee_payment_state == 'unpaid'"
                                   decoration-muted="fee_payment_state == 'none'"
                                   invisible="fee_payment_state == 'none'"/>
                            <!-- Indicateur discret : les frais sont partis au guichet mais pas
                                 encore encaissés. Ne duplique PAS fee_payment_state (qui reste
                                 'unpaid' dans ce cas) - simple repère pour le gestionnaire. -->
                            <div class="text-muted fst-italic" invisible="not fee_sent_to_cashier or fee_paid">
                                En attente d'encaissement en caisse
                            </div>
                            <field name="fee_sent_to_cashier" invisible="1"/>
                            <field name="fee_charged_before_disbursement" invisible="1"/>
                            <field name="fee_paid" invisible="1"/>
                            <field name="fee_receivable_move_id" readonly="1" invisible="not fee_receivable_move_id"/>
                            <field name="fee_move_id" readonly="1"/>
                            <field name="net_disbursed_amount" readonly="1"/>
                            <field name="bypass_cash_balance" invisible="state != 'approved'"/>
                        </group>
                        <!-- guarantee_total sert aussi d'ancrage pour les champs épargne/
                             garanties injectés par microfinance_savings_management
                             (xpath position="after" sur ce champ). -->
                        <group string="Résumé financier — Épargne / Garanties">
                            <field name="guarantee_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Avis CA / CDAG" invisible="state not in ('avis_ca', 'avis_cdag', 'approved', 'active', 'closed', 'defaulted', 'written_off')">
                            <!-- Pas de readonly par état ni de restriction groups= ici (agence
                                 CA / CDAG, qui CA peut modifier quel bloc) : Lot 2 du chantier
                                 Avis CA/CDAG, séparé - hors périmètre de ce Lot 1. Un readonly
                                 conditionné à l'état a été testé puis retiré : Odoo n'enregistre
                                 jamais un champ readonly même modifié par onchange (cf.
                                 odoo/tests/form.py:405, "does not save readonly fields"), ce qui
                                 bloquait précisément la cascade CA -> CDAG (elle écrit
                                 avis_cdag_* alors que l'état est encore 'avis_ca') - constaté en
                                 test, pas une supposition. -->
                            <field name="avis_cdag_manually_set" invisible="1"/>
                            <group>
                                <group string="Avis CA">
                                    <field name="avis_ca_amount"/>
                                    <field name="avis_ca_epargne_exigee"/>
                                    <field name="avis_ca_installment_amount"/>
                                    <field name="avis_ca_term"/>
                                </group>
                                <group string="Avis CDAG">
                                    <field name="avis_cdag_amount"/>
                                    <field name="avis_cdag_epargne_exigee"/>
                                    <field name="avis_cdag_installment_amount"/>
                                    <field name="avis_cdag_term"/>
                                </group>
                            </group>
                        </page>
                        <!-- readonly="1" : empêche l'édition manuelle des lignes, pas un obstacle
                             à la persistance - write() (re)génère réellement ce champ à chaque
                             sauvegarde tant que le crédit est modifiable, y compris la première
                             fois (cf. _SCHEDULE_TRIGGER_FIELDS, microfinance_loan.py) ; l'aperçu
                             onchange seul ne suffisait pas (cf. docs_dev/echeancier_obsolete_
                             readonly/AUDIT.md). Il n'y a plus de bouton "Générer échéancier" :
                             cf. docs_dev/retrait_bouton_generer_echeancier/. -->
                        <page string="Échéancier"><field name="installment_ids" readonly="1"/></page>
                        <page string="Remboursements"><field name="payment_ids" readonly="1"/></page>
                        <page string="Garanties"><field name="guarantee_ids" context="{'default_loan_id': id}"/></page>
                        <page string="Recouvrement"><field name="visit_ids"/></page>
                        <page string="Historique de rééchelonnement">
                            <field name="reschedule_history_ids" readonly="1">
                                <tree>
                                    <field name="reschedule_date"/>
                                    <field name="user_id"/>
                                    <field name="reason"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="reschedule_date"/>
                                        <field name="user_id"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="reason"/>
                                    </group>
                                    <field name="old_installment_ids">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="sequence"/>
                                            <field name="due_date"/>
                                            <field name="currency_id" column_invisible="1"/>
                                            <field name="principal_amount"/>
                                            <field name="interest_amount"/>
                                            <field name="penalty_amount"/>
                                            <field name="paid_principal"/>
                                            <field name="paid_interest"/>
                                            <field name="paid_penalty"/>
                                            <field name="residual_amount"/>
                                        </tree>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_microfinance_loan" model="ir.actions.act_window">
        <field name="name">Crédits</field>
        <field name="res_model">microfinance.loan</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <!-- Efface explicitement les view_ids des vues readonly.create retirées (Lot 2,
             réversion du point d'entrée unique) : omettre le champ ne suffit pas à vider un
             one2many déjà peuplé sur une instance existante lors d'un -u, Odoo ne touche que
             les champs présents dans la définition. -->
        <field name="view_ids" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
