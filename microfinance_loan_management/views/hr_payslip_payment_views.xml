<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paiement du net des salaires en transit (journal d'exploitation, 139500 soldé par le relevé) -->
    <record id="seq_hr_payslip_payment" model="ir.sequence">
        <field name="name">Paiement de salaires</field>
        <field name="code">hr.payslip.payment</field>
        <field name="prefix">PSAL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="rule_hr_payslip_payment_company" model="ir.rule">
        <field name="name">Paiement de salaires : sociétés autorisées</field>
        <field name="model_id" ref="model_hr_payslip_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payslip_payment_line_company" model="ir.rule">
        <field name="name">Ligne de paiement de salaires : sociétés autorisées</field>
        <field name="model_id" ref="model_hr_payslip_payment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="access_hr_payslip_payment_manager" model="ir.model.access">
        <field name="name">hr.payslip.payment.manager</field>
        <field name="model_id" ref="model_hr_payslip_payment"/>
        <field name="group_id" ref="hr_payroll_community.group_hr_payroll_community_manager"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_hr_payslip_payment_account" model="ir.model.access">
        <field name="name">hr.payslip.payment.account</field>
        <field name="model_id" ref="model_hr_payslip_payment"/>
        <field name="group_id" ref="account.group_account_manager"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_hr_payslip_payment_comptable" model="ir.model.access">
        <field name="name">hr.payslip.payment.comptable</field>
        <field name="model_id" ref="model_hr_payslip_payment"/>
        <field name="group_id" ref="group_microfinance_comptable"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_hr_payslip_payment_line_manager" model="ir.model.access">
        <field name="name">hr.payslip.payment.line.manager</field>
        <field name="model_id" ref="model_hr_payslip_payment_line"/>
        <field name="group_id" ref="hr_payroll_community.group_hr_payroll_community_manager"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_hr_payslip_payment_line_account" model="ir.model.access">
        <field name="name">hr.payslip.payment.line.account</field>
        <field name="model_id" ref="model_hr_payslip_payment_line"/>
        <field name="group_id" ref="account.group_account_manager"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_hr_payslip_payment_line_comptable" model="ir.model.access">
        <field name="name">hr.payslip.payment.line.comptable</field>
        <field name="model_id" ref="model_hr_payslip_payment_line"/>
        <field name="group_id" ref="group_microfinance_comptable"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_payslip_payment_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.payment.tree</field>
        <field name="model">hr.payslip.payment</field>
        <field name="arch" type="xml">
            <tree string="Paiements de salaires" decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="bank_id"/>
                <field name="journal_id"/>
                <field name="payslip_run_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="hr_payslip_payment_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.payment.form</field>
        <field name="model">hr.payslip.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement de salaires" create="0">
                <header>
                    <button name="action_validate" type="object" string="Valider le paiement" class="oe_highlight"
                            invisible="state != 'draft'" groups="hr_payroll_community.group_hr_payroll_community_manager"/>
                    <button name="action_cancel" type="object" string="Annuler le paiement"
                            invisible="state == 'cancelled'" groups="hr_payroll_community.group_hr_payroll_community_manager"
                            confirm="Annuler ce paiement ? Une écriture d'extourne sera passée tant que le relevé n'a pas rapproché la sortie."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning_message">
                        <field name="warning_message" nolabel="1"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                            <field name="journal_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="bank_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payslip_run_id" invisible="not payslip_run_id"/>
                            <field name="amount_total"/>
                            <field name="split_bank_lines" readonly="state != 'draft'"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="reversal_move_id" invisible="not reversal_move_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree string="Bulletins payés">
                            <field name="payslip_id"/>
                            <field name="employee_id"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_payslip_payment_action" model="ir.actions.act_window">
        <field name="name">Paiements de salaires</field>
        <field name="res_model">hr.payslip.payment</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_hr_payslip_payment" action="hr_payslip_payment_action"
              parent="hr_payroll_community.menu_hr_payroll_community_root" sequence="60"/>

    <!-- Bulletin : statut bancaire, paiement, chatter -->
    <record id="hr_payslip_view_form_payment" model="ir.ui.view">
        <field name="name">hr.payslip.form.payment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_refund_sheet']" position="before">
                <button string="Annuler le paiement" name="action_cancel_payment" type="object"
                        invisible="mf_bank_status != 'transit'"
                        groups="hr_payroll_community.group_hr_payroll_community_manager"/>
            </xpath>
            <xpath expr="//button[@name='action_open_move']" position="after">
                <button name="action_open_payment" class="oe_stat_button" icon="fa-money" type="object"
                        invisible="mf_bank_status == 'unpaid'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Paiement</span>
                        <span class="o_stat_text">du net</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='credit_note']" position="after">
                <field name="mf_bank_status" widget="badge"
                       decoration-success="mf_bank_status == 'confirmed'"
                       decoration-warning="mf_bank_status == 'transit'"
                       decoration-muted="mf_bank_status == 'unpaid'"/>
                <field name="mf_payment_id" invisible="not mf_payment_id"/>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_tree_payment" model="ir.ui.view">
        <field name="name">hr.payslip.tree.payment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="mf_bank_status" widget="badge"
                       decoration-success="mf_bank_status == 'confirmed'"
                       decoration-warning="mf_bank_status == 'transit'"
                       decoration-muted="mf_bank_status == 'unpaid'"/>
            </field>
        </field>
    </record>

    <!-- Lot de bulletins : « Marquer Payé », paiements, chatter -->
    <record id="hr_payslip_run_view_form_payment" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.payment</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_validate_payslips']" position="after">
                <button string="Marquer Payé" name="action_payslip_paid" type="object" class="oe_highlight"
                        groups="hr_payroll_community.group_hr_payroll_community_manager"/>
            </xpath>
            <xpath expr="//button[@name='action_payslip_run']" position="before">
                <button string="Paiements de salaires" name="action_open_payments" type="object"
                        invisible="not payment_ids"/>
                <field name="payment_ids" invisible="1"/>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>
</odoo>
