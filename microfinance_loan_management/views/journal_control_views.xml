<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Contrôle des journaux : écran interactif (même famille que le Grand livre et la Balance générale). Le menu
         d'origine de base_accounting_kit garde son identifiant : seule son action change, ses restrictions de groupes
         sont levées (l'accès est contrôlé par le contrôleur). L'ancien assistant (account.print.journal) et son PDF
         restent dans la base. -->
    <record id="action_journal_control_mf" model="ir.actions.client">
        <field name="name">Contrôle des journaux</field>
        <field name="tag">microfinance_loan_management.journal_control</field>
        <field name="params" eval="{'report_title': 'Contrôle des journaux'}"/>
    </record>

    <record id="base_accounting_kit.menu_print_journal" model="ir.ui.menu">
        <field name="name">Contrôle des journaux</field>
        <field name="action" eval="'ir.actions.client,%d' % ref('microfinance_loan_management.action_journal_control_mf')"/>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
