<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_caisse_comptage_tree" model="ir.ui.view">
        <field name="name">microfinance.caisse.comptage.tree</field>
        <field name="model">microfinance.caisse.comptage</field>
        <field name="arch" type="xml">
            <tree decoration-warning="abs(variance) &gt; 0.01">
                <field name="name"/>
                <field name="session_id"/>
                <field name="date"/>
                <field name="counted_by"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="theoretical_total"/>
                <field name="counted_total"/>
                <field name="variance"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_microfinance_caisse_comptage_form" model="ir.ui.view">
        <field name="name">microfinance.caisse.comptage.form</field>
        <field name="model">microfinance.caisse.comptage</field>
        <field name="arch" type="xml">
            <form string="Comptage de billetage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="counted_by" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="theoretical_total" readonly="1"/>
                            <field name="counted_total" readonly="1"/>
                            <field name="variance" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree>
                            <field name="denomination_id"/>
                            <field name="denomination_value"/>
                            <field name="quantity"/>
                            <field name="subtotal"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                    <group string="Écart">
                        <field name="variance_comment" readonly="1" nolabel="1"
                               placeholder="Aucun motif (comptage sans écart)."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_microfinance_caisse_comptage_search" model="ir.ui.view">
        <field name="name">microfinance.caisse.comptage.search</field>
        <field name="model">microfinance.caisse.comptage</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <field name="counted_by"/>
                <field name="company_id"/>
                <filter name="with_variance" string="Avec écart"
                        domain="['|', ('variance', '&gt;', 0.01), ('variance', '&lt;', -0.01)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                    <filter name="group_cashier" string="Compté par" context="{'group_by': 'counted_by'}"/>
                    <filter name="group_company" string="Agence" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_microfinance_caisse_comptage" model="ir.actions.act_window">
        <field name="name">Comptages de billetage</field>
        <field name="res_model">microfinance.caisse.comptage</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
