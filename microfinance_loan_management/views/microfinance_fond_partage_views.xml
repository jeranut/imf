<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_fond_partage_tree" model="ir.ui.view">
        <field name="name">microfinance.fond.partage.tree</field>
        <field name="model">microfinance.fond.partage</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'validated'" decoration-muted="state == 'cancelled'">
                <field name="name" string="Référence"/>
                <field name="date" string="Date"/>
                <field name="fond_id" string="Fonds de crédit"/>
                <field name="base_amount" string="Montant à partager"/>
                <field name="state" string="État" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_microfinance_fond_partage_form" model="ir.ui.view">
        <field name="name">microfinance.fond.partage.form</field>
        <field name="model">microfinance.fond.partage</field>
        <field name="arch" type="xml">
            <form string="Partage de fonds">
                <header>
                    <field name="can_manage_funds" invisible="1"/>
                    <button name="action_partager_egalement" type="object" string="Partager également"
                            invisible="state != 'draft' or not can_manage_funds or base_amount &lt;= 0 or not line_ids"/>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'draft' or not can_manage_funds"
                            confirm="Valider ce partage ? Les fonds deviendront disponibles dans chaque agence."/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled' or not can_manage_funds"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="fond_id" string="Fonds de crédit" readonly="state != 'draft'"/>
                            <field name="date" string="Date" readonly="state != 'draft'"/>
                            <field name="company_id" string="Société mère" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="reste_partageable" string="Reste partageable du fonds"/>
                            <field name="base_amount" string="Montant à partager" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="company_id" string="Agence" force_save="1" readonly="1"/>
                            <field name="percent" string="Part (%)"/>
                            <field name="amount" string="Montant"/>
                            <field name="percent_ref" column_invisible="1"/>
                            <field name="amount_ref" column_invisible="1"/>
                        </tree>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_percent" string="Total (%)"/>
                        <field name="total_amount" string="Total réparti"/>
                        <field name="reste_a_partager" string="Reste à répartir"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_microfinance_fond_partage_search" model="ir.ui.view">
        <field name="name">microfinance.fond.partage.search</field>
        <field name="model">microfinance.fond.partage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Référence"/>
                <field name="fond_id" string="Fonds de crédit"/>
                <filter name="filter_draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_validated" string="Validés" domain="[('state', '=', 'validated')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_fond" string="Fonds" context="{'group_by': 'fond_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_microfinance_fond_partage" model="ir.actions.act_window">
        <field name="name">Partage des fonds</field>
        <field name="res_model">microfinance.fond.partage</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun partage de fonds</p>
            <p>Réservé à la société mère : répartissez un fonds multi-agences entre les agences.</p>
        </field>
    </record>
</odoo>
