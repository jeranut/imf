<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Numérotation de microfinance.loan, microfinance.loan.application et
         microfinance.loan.payment : plus de séquence globale ici, remplacée par une séquence
         dédiée par société créée à la demande (voir res.company._get_or_create_numbering_sequence),
         format AGENCE/SÉRIE (cf. correctif numérotation Sous-lot 3 pour microfinance.loan.payment,
         qui utilisait auparavant seq_microfinance_payment, PAY/%(year)s/NNNNN, globale — retirée
         ici ; les remboursements déjà enregistrés gardent leur ancien numéro tel quel en base,
         cette suppression n'affecte que la génération des futurs numéros). -->
    <!-- Pas de préfixe statique ici : le préfixe est configurable par société
         (res.company.loan_product_code_prefix) et concaténé en Python à la création du
         produit. Séquence volontairement globale (company_id vide), comme les deux ci-dessus :
         un compteur unique pour toutes les sociétés, plus simple à maintenir qu'un compteur par
         société — seul le préfixe affiché varie selon la société. -->
    <record id="seq_microfinance_loan_product" model="ir.sequence">
        <field name="name">Code produit de crédit microfinance</field>
        <field name="code">microfinance.loan.product</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_microfinance_fond_credit" model="ir.sequence">
        <field name="name">Fonds de crédit bailleur</field>
        <field name="code">microfinance.fond.credit</field>
        <field name="prefix">FND/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
