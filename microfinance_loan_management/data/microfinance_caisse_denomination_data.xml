<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- VALEURS PAR DÉFAUT, NON VALIDÉES — proposition de coupures usuelles en Ariary (MGA).
         Destinées à être ajustées par le manager/finance depuis
         Configuration > Caisse > Coupures de caisse (ajout, désactivation via `active`,
         modification de valeur). Ne pas les traiter comme une liste définitive.
         noupdate="1" : une mise à jour du module ne réécrit pas ces enregistrements si Micka
         les a modifiés. -->

    <!-- Billets -->
    <record id="caisse_denomination_billet_20000" model="microfinance.caisse.denomination">
        <field name="name">Billet 20 000 Ar</field>
        <field name="value">20000</field>
        <field name="currency_id" ref="base.MGA"/>
    </record>
