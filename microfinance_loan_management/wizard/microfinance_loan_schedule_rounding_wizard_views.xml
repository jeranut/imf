<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_schedule_rounding_wizard_form" model="ir.ui.view">
        <field name="name">microfinance.loan.schedule.rounding.wizard.form</field>
        <field name="model">microfinance.loan.schedule.rounding.wizard</field>
        <field name="arch" type="xml">
            <form string="Génération de l'échéancier">
                <field name="loan_id" invisible="1"/>
                <group>
                    <field name="rounding_mode" widget="radio"/>
                </group>
                <p class="text-muted">
                    Dans les deux cas, la somme totale de l'échéancier reste rigoureusement
                    identique (capital + intérêt) : seule la façon de répartir l'écart
                    d'arrondi entre les tranches change.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Générer l'échéancier"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
