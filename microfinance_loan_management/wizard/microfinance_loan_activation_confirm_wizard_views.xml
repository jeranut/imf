<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_activation_confirm_wizard_form" model="ir.ui.view">
        <field name="name">microfinance.loan.activation.confirm.wizard.form</field>
        <field name="model">microfinance.loan.activation.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmer la date de décaissement">
                <group>
                    <field name="loan_id" readonly="1"/>
                    <field name="disbursement_date_planned"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmer et activer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
