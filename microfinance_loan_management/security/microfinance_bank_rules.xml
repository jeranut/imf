<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lignes saisies et historique d'un relevé bancaire : mêmes sociétés que le relevé (chef d'agence = sa société,
         direction du siège = les sociétés cochées). -->
    <record id="microfinance_bank_entry_company_rule" model="ir.rule">
        <field name="name">Microfinance ligne de relevé bancaire : sociétés autorisées</field>
        <field name="model_id" ref="model_microfinance_bank_statement_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>
    <record id="microfinance_bank_log_company_rule" model="ir.rule">
        <field name="name">Microfinance historique de relevé bancaire : sociétés autorisées</field>
        <field name="model_id" ref="model_microfinance_bank_statement_log"/>
        <field name="domain_force">[('statement_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>
</odoo>
