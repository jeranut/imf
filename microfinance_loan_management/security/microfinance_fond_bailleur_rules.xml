<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- microfinance.bailleur.fonds : référentiel global sans company_id (comme "Professions" ou
         "Périodicités de remboursement"), volontairement partagé entre toutes les agences, sans
         règle ir.rule : un même bailleur peut financer plusieurs agences sans dupliquer sa fiche. -->

    <!-- microfinance.fond.credit et microfinance.fond.contribution : PREMIÈRE occurrence dans ce
         module d'un pattern de "partage optionnel" par société, différent du cloisonnement
         strict utilisé partout ailleurs (security/microfinance_company_rules.xml, domaine
         [('company_id', 'in', company_ids)] sans clause OR). Un fonds "single_company"
         (company_id renseigné) n'est visible que dans son agence, comme d'habitude ; un fonds
         "multi_company" (company_id vide) est en revanche visible et exploitable depuis TOUTES
         les agences, par conception (fonds bailleur partagé/consolidé entre plusieurs agences).
         Ne pas "corriger" ce domaine lors d'un futur audit multi-société : l'absence de
         cloisonnement strict sur la branche company_id=False est intentionnelle ici. -->
    <record id="microfinance_fond_credit_company_rule" model="ir.rule">
        <field name="name">Microfinance fonds de crédit bailleur : partage optionnel par société</field>
        <field name="model_id" ref="model_microfinance_fond_credit"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[]"/>
    </record>

    <!-- Contribution : company_id est un champ related=fond_id.company_id, store=True. Une contribution d'un fonds
         d'agence est visible de son agence ; celle d'un fonds multi-agences (company_id vide) n'est lisible que de
         la société qui l'a saisie (la mère) : une agence ne doit pas voir le dépôt total du bailleur, seulement sa
         part (allocation). Les totaux stockés du fonds sont calculés en sudo (microfinance_fond_vue_agence.py). -->
    <record id="microfinance_fond_contribution_company_rule" model="ir.rule">
        <field name="name">Microfinance contribution bailleur : agence ou société de saisie</field>
        <field name="model_id" ref="model_microfinance_fond_contribution"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), '&amp;', ('company_id', '=', False), ('saisie_company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>

    <!-- Fonds d'exploitation : visibles de Manager crédit, Comptable et gestionnaire comptable d'Odoo seulement.
         Règle globale : Agent crédit (donc Caissier, Agent épargne…), Finance et Auditeur ont une lecture ACL sur les
         fonds de crédit et ne doivent jamais lire un fonds d'exploitation ni ses contributions, même par URL directe. -->
    <record id="microfinance_fond_exploitation_visibility_rule" model="ir.rule">
        <field name="name">Microfinance fonds d'exploitation : direction et comptabilité seulement</field>
        <field name="model_id" ref="model_microfinance_fond_credit"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('microfinance_loan_management.group_microfinance_manager') or user.has_group('microfinance_loan_management.group_microfinance_comptable') or user.has_group('account.group_account_manager')) else [('destination', '!=', 'exploitation')]</field>
        <field name="groups" eval="[]"/>
    </record>
    <record id="microfinance_fond_exploitation_contribution_visibility_rule" model="ir.rule">
        <field name="name">Microfinance contributions d'exploitation : direction et comptabilité seulement</field>
        <field name="model_id" ref="model_microfinance_fond_contribution"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('microfinance_loan_management.group_microfinance_manager') or user.has_group('microfinance_loan_management.group_microfinance_comptable') or user.has_group('account.group_account_manager')) else [('fond_id.destination', '!=', 'exploitation')]</field>
        <field name="groups" eval="[]"/>
    </record>

    <!-- microfinance.fond.allocation : cloisonnement strict par agence (pas de clause OR) : chaque
         agence ne voit que sa propre part des fonds partagés. Création/modification réservées au
         partage (contexte technique, cf. models/microfinance_fond_allocation.py). -->
    <record id="microfinance_fond_allocation_company_rule" model="ir.rule">
        <field name="name">Microfinance allocation de fonds : cloisonnement par société</field>
        <field name="model_id" ref="model_microfinance_fond_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>

    <!-- Partage : visible seulement de la société qui l'a établi (la mère) ; les agences ne voient
         que leur allocation. Les lignes suivent l'en-tête. -->
    <record id="microfinance_fond_partage_company_rule" model="ir.rule">
        <field name="name">Microfinance partage de fonds : société mère uniquement</field>
        <field name="model_id" ref="model_microfinance_fond_partage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>
    <record id="microfinance_fond_partage_line_company_rule" model="ir.rule">
        <field name="name">Microfinance parts de partage de fonds : société mère uniquement</field>
        <field name="model_id" ref="model_microfinance_fond_partage_line"/>
        <field name="domain_force">[('partage_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[]"/>
    </record>

    <!-- Partages de fonds d'exploitation : direction du siège et comptabilité seulement. Finance et Auditeur lisent les
         partages de crédit (ACL) mais jamais ceux d'exploitation, même par URL directe. -->
    <record id="microfinance_fond_partage_exploitation_visibility_rule" model="ir.rule">
        <field name="name">Microfinance partages d'exploitation : direction et comptabilité seulement</field>
        <field name="model_id" ref="model_microfinance_fond_partage"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('microfinance_loan_management.group_microfinance_manager') or user.has_group('microfinance_loan_management.group_microfinance_comptable') or user.has_group('account.group_account_manager')) else [('destination', '!=', 'exploitation')]</field>
        <field name="groups" eval="[]"/>
    </record>
    <record id="microfinance_fond_partage_line_exploitation_visibility_rule" model="ir.rule">
        <field name="name">Microfinance parts d'exploitation : direction et comptabilité seulement</field>
        <field name="model_id" ref="model_microfinance_fond_partage_line"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('microfinance_loan_management.group_microfinance_manager') or user.has_group('microfinance_loan_management.group_microfinance_comptable') or user.has_group('account.group_account_manager')) else [('destination', '!=', 'exploitation')]</field>
        <field name="groups" eval="[]"/>
    </record>
</odoo>
