<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_product_tree_payroll" model="ir.ui.view">
        <field name="name">microfinance.loan.product.tree.payroll</field>
        <field name="model">microfinance.loan.product</field>
        <field name="inherit_id" ref="microfinance_loan_management.view_microfinance_loan_product_tree"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="employee_authorized"/>
            </field>
        </field>
    </record>

    <record id="view_microfinance_loan_product_form_payroll" model="ir.ui.view">
        <field name="name">microfinance.loan.product.form.payroll</field>
        <field name="model">microfinance.loan.product</field>
        <field name="inherit_id" ref="microfinance_loan_management.view_microfinance_loan_product_form"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="employee_authorized"/>
            </field>
        </field>
    </record>
</odoo>
