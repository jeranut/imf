<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_form_regularize_salary_deduction" model="ir.ui.view">
        <field name="name">microfinance.loan.form.regularize.salary.deduction</field>
        <field name="model">microfinance.loan</field>
        <field name="inherit_id" ref="microfinance_loan_management.view_microfinance_loan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_mark_default']" position="after">
                <field name="product_employee_authorized" invisible="1"/>
                <field name="salary_deduction" invisible="1"/>
                <field name="disbursement_date" invisible="1"/>
                <button name="action_microfinance_regularize_salary_deduction"
                        string="Régulariser la retenue sur salaire" type="object"
                        groups="microfinance_loan_management.group_microfinance_gestionnaire"
                        invisible="not disbursement_date or salary_deduction or not product_employee_authorized"/>
            </xpath>
        </field>
    </record>

    <record id="view_microfinance_loan_salary_deduction_regularization_wizard_form" model="ir.ui.view">
        <field name="name">microfinance.loan.salary.deduction.regularization.wizard.form</field>
        <field name="model">microfinance.loan.salary.deduction.regularization.wizard</field>
        <field name="arch" type="xml">
            <form string="Régulariser la retenue sur salaire">
                <group>
                    <field name="loan_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="employee_id"/>
                </group>
                <field name="reason" placeholder="Motif de la régularisation (obligatoire)"/>
                <footer>
                    <button name="action_confirm" string="Régulariser" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
