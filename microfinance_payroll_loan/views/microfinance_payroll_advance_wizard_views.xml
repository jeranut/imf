<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_payroll_advance_wizard_form" model="ir.ui.view">
        <field name="name">microfinance.payroll.advance.wizard.form</field>
        <field name="model">microfinance.payroll.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Avance spéciale">
                <field name="available_officer_ids" invisible="1"/>
                <field name="candidate_partner_ids" invisible="1"/>
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="officer_id"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="not candidate_partner_ids">
                    <p>Plusieurs clients existants correspondent à cet employé (nom/e-mail,
                       sans CIN identique) : choisissez le bon ci-dessous avant de valider.
                       Aucune réutilisation ni création automatique n'est faite dans ce cas.</p>
                    <field name="selected_partner_id"/>
                </div>
                <field name="note" placeholder="Note libre (facultatif)"/>
                <footer>
                    <button name="action_validate" string="Valider" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
