<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_view_form_mowgli_sync" model="ir.ui.view">
        <field name="name">hr.payroll.structure.view.form.mowgli.sync</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id"
               ref="hr_payroll_community.hr_payroll_structure_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="before">
                <header>
                    <button name="action_open_mowgli_sync_wizard"
                            string="Compléter les comptes de paie par société"
                            type="object" class="btn-primary"
                            groups="hr_payroll_community.group_hr_payroll_community_manager"/>
                </header>
            </xpath>
            <xpath expr="//group[1]" position="inside">
                <field name="mowgli_source_id" invisible="1"/>
            </xpath>
            <xpath expr="//form" position="inside">
                <chatter/>
            </xpath>
        </field>
    </record>
</odoo>
