<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mowgli_payroll_contribution_wizard_form" model="ir.ui.view">
        <field name="name">mowgli.payroll.contribution.wizard.form</field>
        <field name="model">mowgli.payroll.contribution.wizard</field>
        <field name="arch" type="xml">
            <form string="Marquer déclaré / versé">
                <group>
                    <field name="target_state" widget="radio"/>
                    <field name="reference"/>
                    <field name="payment_date" invisible="target_state != 'verse'"/>
                </group>
                <footer>
                    <button string="Appliquer" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="mowgli_payroll_contribution_wizard_action" model="ir.actions.act_window">
        <field name="name">Marquer déclaré / versé</field>
        <field name="res_model">mowgli.payroll.contribution.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mowgli_payroll_contribution"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
