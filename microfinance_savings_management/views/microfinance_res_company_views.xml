<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_microfinance_savings" model="ir.ui.view">
        <field name="name">res.company.form.inherit.microfinance.savings</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="savings_product_code_locked" invisible="1"/>
                <field name="savings_product_code_prefix" readonly="savings_product_code_locked"/>
            </xpath>
            <!-- Champ déplacé dans un groupe labellisé (au lieu d'un champ nu après le nom de
                 société, sans étiquette ni bordure visible) : invisible en pratique dans ce
                 style, ce qui rendait le réglage introuvable pour un manager cherchant à le
                 configurer (cf. retour Micka du 2026-08-15). -->
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Épargne (microfinance)" groups="microfinance_loan_management.group_microfinance_manager">
                    <field name="microfinance_savings_default_product_id"
                           placeholder="Aucun compte épargne ne sera ouvert automatiquement tant qu'aucun produit n'est choisi ici"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
