<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_savings_account_tree" model="ir.ui.view">
        <field name="name">microfinance.savings.account.tree</field>
        <field name="model">microfinance.savings.account</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'closed'" decoration-warning="state == 'dormant'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <!-- currency_id chargé (colonne masquée) : requis pour que le sous-total sum=
                     ci-dessous affiche "Ar"/MGA en pied de liste plutôt que "—", même patron
                     que microfinance_loan_views.xml (view_microfinance_loan_tree). -->
                <field name="currency_id" column_invisible="1"/>
                <field name="balance" sum="Total"/>
                <field name="maturity_date"/>
                <field name="state" widget="badge"/>
                <field name="legacy_number" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_microfinance_savings_account_search" model="ir.ui.view">
        <field name="name">microfinance.savings.account.search</field>
        <field name="model">microfinance.savings.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('legacy_number', 'ilike', self)]"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="active" string="Actifs" domain="[('state','=','active')]"/>
                <filter name="dormant" string="Dormants" domain="[('state','=','dormant')]"/>
                <filter name="maturing_30d" string="Échéance sous 30 jours" domain="[('maturity_date','!=',False),('maturity_date','&lt;=',(context_today()+relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_account" string="Compte épargne" context="{'group_by':'account_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by':'state'}"/>
                    <filter name="group_product" string="Produit" context="{'group_by':'product_id'}"/>
                    <filter name="group_company" string="Société" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                </group>
                <searchpanel>
                    <field name="state" select="multi" icon="fa-flag" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="view_microfinance_savings_account_form" model="ir.ui.view">
        <field name="name">microfinance.savings.account.form</field>
        <field name="model">microfinance.savings.account</field>
        <field name="arch" type="xml">
            <form string="Produit d'épargne">
                <header>
                    <button name="action_activate" string="Activer" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Clôturer" type="object" invisible="state not in ('active','dormant')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,dormant,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="loan_count" widget="statinfo" string="Crédits"/>
                        </button>
                        <button name="action_view_loan_account" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="not loan_account_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Compte crédit</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Produit">
                            <field name="account_id" readonly="1" invisible="not id"/>
                            <field name="partner_id" readonly="id" domain="[('microfinance_partner_type', '=', 'client')]" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" context="{'microfinance_context': True}"/>
                            <field name="loan_account_id" invisible="1"/>
                            <field name="product_id" required="1" readonly="id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"/>
                            <field name="currency_id"/>
                            <field name="microfinance_loan_id"/>
                            <field name="rank" invisible="not rank"/>
                            <field name="legacy_number" invisible="not legacy_number"/>
                        </group>
                        <group string="Suivi">
                            <field name="opening_date" readonly="1"/>
                            <field name="closing_date" readonly="1"/>
                            <field name="maturity_date" readonly="1"/>
                            <field name="last_transaction_date" readonly="1"/>
                            <field name="is_dormant" readonly="1"/>
                        </group>
                    </group>
                    <group string="Solde">
                        <field name="balance" readonly="1"/>
                    </group>
                    <group string="Clôture" invisible="state != 'closed'">
                        <field name="closure_reason_type"/>
                        <field name="closure_reason_note"/>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" readonly="1">
                                <tree default_order="date desc, id desc">
                                    <field name="date"/>
                                    <!-- currency_id chargé (colonne masquée) : requis pour que
                                         l'agrégat "sum" des colonnes monétaires ci-dessous
                                         s'affiche (Odoo 17 : sans champ devise actif, le pied
                                         de liste montre "—", cf. list_renderer getAggregates).
                                         Même patron que income_line_*_ids dans
                                         microfinance_loan_application_views.xml. -->
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="deposit_amount" sum="Total dépôts"/>
                                    <field name="withdrawal_amount" sum="Total retraits"/>
                                    <field name="payment_method"/>
                                    <field name="move_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Vue d'attribution : seule entrée de création d'un produit d'épargne (smart button
         « Épargne » de res.partner, bouton « Épargne » du crédit) - cf.
         docs_dev/attribution_epargne_client/. Le titulaire et l'agence sont déjà connus (le
         contexte d'appel les fixe) : partner_id/company_id passent en lecture seule
         inconditionnelle (pas seulement readonly="id" comme la vue générique, qui reste
         modifiable à la création) ; l'agent ne choisit que le produit d'épargne. -->
    <record id="view_microfinance_savings_account_form_attribution" model="ir.ui.view">
        <field name="name">microfinance.savings.account.form.attribution</field>
        <field name="model">microfinance.savings.account</field>
        <field name="inherit_id" ref="view_microfinance_savings_account_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
    <!-- Vues sans création, import ni duplication : balance épargne et listes ouvertes par les
         tuiles du tableau de bord (même domaine que la tuile, aucune création depuis la liste). -->
    <record id="view_microfinance_savings_account_tree_menu" model="ir.ui.view">
        <field name="name">microfinance.savings.account.tree.menu.readonly.create</field>
        <field name="model">microfinance.savings.account</field>
        <field name="inherit_id" ref="view_microfinance_savings_account_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="import">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_microfinance_savings_account_form_menu" model="ir.ui.view">
        <field name="name">microfinance.savings.account.form.menu.readonly.create</field>
        <field name="model">microfinance.savings.account</field>
        <field name="inherit_id" ref="view_microfinance_savings_account_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="duplicate">0</attribute>
            </xpath>
        </field>
    </record>
    <!-- Menu « Produits d'épargne » : CONSULTATION SEULE depuis ce lot (docs_dev/
         attribution_epargne_client/) - l'attribution (création) d'un produit se fait
         uniquement depuis le smart button « Épargne » de la fiche client ou le bouton
         « Épargne » du crédit (res_partner.py / microfinance_loan_extension.py), jamais
         depuis ce menu. Vues *_menu (déjà create="0" import="0"/duplicate="0", réutilisées
         telles quelles - elles servaient déjà aux tuiles du tableau de bord et à la balance
         épargne) + context savings_menu_readonly=True, lu par microfinance.savings.account.
         create() : garde serveur en cas de contournement des vues (ex. action forgée avec ce
         même contexte). Les anciens conteneurs (sans compte) n'y apparaissent pas. -->
    <record id="action_microfinance_savings_account" model="ir.actions.act_window">
        <field name="name">Produits d'épargne</field>
        <field name="res_model">microfinance.savings.account</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('account_id', '!=', False)]</field>
        <field name="context">{'search_default_active': 1, 'savings_menu_readonly': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_microfinance_savings_account_tree_menu')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_microfinance_savings_account_form_menu')}),
        ]"/>
    </record>
    <record id="action_microfinance_savings_balance_report" model="ir.actions.act_window">
        <field name="name">Balance épargne</field>
        <field name="res_model">microfinance.savings.account</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('account_id', '!=', False)]</field>
        <field name="context">{'search_default_active': 1, 'search_default_group_product': 1}</field>
        <field name="search_view_id" ref="view_microfinance_savings_account_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_microfinance_savings_account_tree_menu')}),
        ]"/>
    </record>
</odoo>
