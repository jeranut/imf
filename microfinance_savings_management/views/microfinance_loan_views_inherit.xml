<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_loan_form_inherit_savings" model="ir.ui.view">
        <field name="name">microfinance.loan.form.inherit.savings</field>
        <field name="model">microfinance.loan</field>
        <field name="inherit_id" ref="microfinance_loan_management.view_microfinance_loan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='action_view_moves']" position="after">
                <button name="action_view_savings_accounts" type="object" class="oe_stat_button" icon="fa-bank">
                    <field name="savings_account_count" widget="statinfo" string="Épargne"/>
                </button>
            </xpath>
            <field name="co_borrower_id" position="after">
                <field name="savings_requirement_type" invisible="1"/>
                <field name="savings_account_id"/>
            </field>
            <field name="fee_move_id" position="after">
                <field name="savings_target_amount" invisible="savings_requirement_type != 'target_during_loan'" readonly="1"/>
                <field name="savings_target_reached" invisible="savings_requirement_type != 'target_during_loan'" readonly="1"/>
                <field name="guarantee_savings_required" invisible="not guarantee_savings_required" readonly="1"/>
                <field name="guarantee_savings_balance" invisible="not guarantee_savings_required" readonly="1"/>
                <field name="guarantee_savings_verified" invisible="not guarantee_savings_required" readonly="1"/>
            </field>
            <!-- Épargne exigée (CA/CDAG), onglet "Avis CA / CDAG" : masqué si le produit n'a pas
                 d'épargne garantie de crédit configurée (réutilise guarantee_savings_required,
                 déjà calculé ci-dessus, comme condition - un invisible= de vue Odoo 17 ne peut
                 pas traverser une relation comme product_id.guarantee_savings_percent, cf.
                 docs_dev/epargne_exigee_ca_cdag/AUDIT.md). readonly="1" redondant avec le compute
                 (déjà readonly de fait) mais ajouté pour la cohérence visuelle avec guarantee_
                 savings_required/balance/verified ci-dessus. -->
            <field name="avis_ca_epargne_exigee" position="attributes">
                <attribute name="invisible">not guarantee_savings_required</attribute>
                <attribute name="readonly">1</attribute>
            </field>
            <field name="avis_cdag_epargne_exigee" position="attributes">
                <attribute name="invisible">not guarantee_savings_required</attribute>
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
</odoo>
