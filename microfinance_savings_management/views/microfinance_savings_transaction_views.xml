<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microfinance_savings_transaction_tree" model="ir.ui.view">
        <field name="name">microfinance.savings.transaction.tree</field>
        <field name="model">microfinance.savings.transaction</field>
        <field name="arch" type="xml">
            <!-- create="0" : seule création légitime = guichet (register_operation, sudo) ou
                 clôture de compte (action_close, sudo) - aucune création manuelle en liste/form
                 n'est un flux valide pour ce modèle, cf. verrouillage création hors guichet. -->
            <tree create="0" decoration-danger="transaction_type in ('withdrawal','fee_debit','auto_debit')" decoration-success="transaction_type in ('deposit','interest_credit')">
                <field name="date"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <!-- currency_id chargé (colonne masquée) : requis pour que les sous-totaux sum=
                     ci-dessous affichent "Ar"/MGA en pied de liste plutôt que "—". -->
                <field name="currency_id" column_invisible="1"/>
                <!-- Colonne "Montant" unique remplacée par Dépôt/Retrait (deposit_amount/
                     withdrawal_amount, déjà définis et calculés sur le modèle - CREDIT_TYPES/
                     DEBIT_TYPES, microfinance_savings_transaction.py), même principe que les
                     colonnes Débit/Crédit des mouvements de caisse. interest_credit tombe dans
                     Dépôt, fee_debit/auto_debit/transfer tombent dans Retrait (déjà la
                     répartition du modèle, pas un nouveau choix fait ici) - aucun type n'est
                     donc laissé à 0 dans les deux colonnes avec les valeurs actuelles de
                     transaction_type. -->
                <field name="deposit_amount" string="Dépôt" sum="Total dépôts"/>
                <field name="withdrawal_amount" string="Retrait" sum="Total retraits"/>
                <field name="payment_method"/>
                <field name="cheque_state" widget="badge" optional="show"/>
                <field name="move_id" optional="show"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_microfinance_savings_transaction_form" model="ir.ui.view">
        <field name="name">microfinance.savings.transaction.form</field>
        <field name="model">microfinance.savings.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction épargne" create="0">
                <header>
                    <button name="action_post" string="Comptabiliser" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_clear_cheque" string="Compenser le chèque" type="object" class="btn-primary"
                            groups="microfinance_savings_management.group_savings_manager"
                            invisible="cheque_state != 'en_attente'"/>
                    <button name="action_reject_cheque" string="Rejeter le chèque" type="object"
                            groups="microfinance_savings_management.group_savings_manager"
                            invisible="cheque_state != 'en_attente'"/>
                    <button name="%(action_report_microfinance_savings_receipt)d" string="Imprimer le reçu" type="action" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="transaction_type"/>
                            <!-- readonly dès qu'une écriture existe (move_id), pas state=='posted' :
                                 un chèque rejeté repasse state à 'cancelled' tout en conservant
                                 move_id (le move d'origine, annulé) - docs_dev/
                                 savings_readonly_amount_history_button/AUDIT.md §2. Doublé d'une
                                 garde serveur (write()) contre une écriture API/import. -->
                            <field name="amount" readonly="move_id"/>
                            <field name="date"/>
                            <field name="payment_method"/>
                            <field name="cheque_state" invisible="payment_method != 'cheque' or transaction_type != 'deposit'"/>
                        </group>
                        <group>
                            <field name="bypass_min_balance" invisible="transaction_type not in ('withdrawal','auto_debit')"/>
                            <field name="bypass_withdrawal_limit" invisible="transaction_type != 'withdrawal'"/>
                            <field name="bypass_cash_balance" invisible="transaction_type not in ('withdrawal','auto_debit','transfer')"/>
                            <field name="related_loan_payment_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="clearing_move_id" readonly="1" invisible="not clearing_move_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_microfinance_savings_transaction_search" model="ir.ui.view">
        <field name="name">microfinance.savings.transaction.search</field>
        <field name="model">microfinance.savings.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <field name="partner_id"/>
                <filter name="posted" string="Comptabilisées" domain="[('state','=','posted')]"/>
                <filter name="cheque_en_attente" string="Chèques en attente" domain="[('cheque_state','=','en_attente')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_type" string="Type" context="{'group_by':'transaction_type'}"/>
                    <filter name="group_account" string="Compte" context="{'group_by':'account_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_microfinance_savings_transaction" model="ir.actions.act_window">
        <field name="name">Transactions épargne</field>
        <field name="res_model">microfinance.savings.transaction</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
